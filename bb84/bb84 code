from qiskit import QuantumCircuit, transpile
from qiskit_aer import AerSimulator

import numpy as np
import matplotlib.pyplot as plt
import random

random.seed(37)

def getRandomBitString(numbits):
    return f"{random.getrandbits(numbits):0{numbits}b}"

def bb84(numqubits):
    # ALICE
    alice_bits = getRandomBitString(numqubits)
    alice_basis = getRandomBitString(numqubits)
    circuit = QuantumCircuit(numqubits, numqubits)

    for qubit_index in range(numqubits):
        if int(alice_bits[qubit_index]) == 1: # if bit is 1, flip |0> to |1>
            circuit.x(qubit_index)
        if int(alice_basis[qubit_index]) == 1: # if basis is 1, new basis is diagonal 
            circuit.h(qubit_index)
    
    #print("basis 1 : diagonal, basis 0 : rectilinear")
    #print(f"{alice_bits} alice sends")
    #print(f"{alice_basis} alice basis")

    # EVE

    eves_basis = getRandomBitString(numqubits)
    #print(f"{eves_basis} eve basis")

    for qubit_index in range(numqubits):
        if int(eves_basis[qubit_index]) == 1: # if 1, measure in diagonal basis
            circuit.h(qubit_index) # have to put in rectilinear basis to measure (apply Hadamard on |+> or |-> to get |0> or |1>)
            circuit.measure(qubit_index, qubit_index)
            circuit.h(qubit_index) # put back in original basis
        if int(eves_basis[qubit_index]) == 0: # if 0, measure in rectilinear basis
            circuit.measure(qubit_index, qubit_index)

    # BOB
    bobs_basis = getRandomBitString(numqubits)

    for qubit_index in range(numqubits):
        if int(bobs_basis[qubit_index]) == 1: # if 1, measure in diagonal basis
            circuit.h(qubit_index)
            circuit.measure(qubit_index, qubit_index)
        if int(bobs_basis[qubit_index]) == 0: # if 0, measure in rectilinear basis
            circuit.measure(qubit_index, qubit_index)
    
    simulator = AerSimulator(method='stabilizer') #should look at different methods. not specifying makes qiskit autoselect the best one. means we can do more qubits
    transpiled_circuit = transpile(circuit, simulator) # need to transpile for the simulator to run it, so it can optimize the circuit for the simulator
    job = simulator.run(transpiled_circuit,shots=1)
    result = job.result()
    counts = result.get_counts()
    #And combine the results
    bobs_bits = list(counts.keys())[0][::-1] # little-endian so flip values

    #print(f"{bobs_basis} bob basis")
    #print(f"{bobs_bits} bob bits")

    Alice_key = ""
    Bob_key = ""

    for i in range(numqubits):
        if alice_basis[i] == bobs_basis[i]: # if basis match, keep bit
            Alice_key += alice_bits[i]
            Bob_key += bobs_bits[i]

    #print(f"Alice's key: {Alice_key}")
    #print(f"Bob's key: {Bob_key}")

    qber = calculateQber(Alice_key, Bob_key)

    return qber

def calculateQber(Alice_key, Bob_key):
    subset = random.sample(range(len(Alice_key)), round(len(Alice_key)/2))
    #print(subset)

    qber = sum(1 for i in subset if Alice_key[i] != Bob_key[i]) / len(subset) # QBER is error rate so need !=
    return qber

ns = np.arange(10,300,1) 
qbers = [bb84(n) for n in ns]

plt.plot(ns,qbers)
plt.axhline(y=0.25, color='r', linestyle='--') # qber = 0.25
plt.xlabel("Number of qubits")
plt.ylabel("Qber")
plt.savefig("qber.png")
plt.show()

